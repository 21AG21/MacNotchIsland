#!/usr/bin/env bash
# notchctl — drive Notch Island from the command line (wraps the notchisland:// URL scheme).
#
#   notchctl activity <id> --title "Building" [--subtitle "xcodebuild"] [--symbol hammer.fill]
#                          [--tint blue] [--progress 0.4] [--trailing "40%"] [--body "…"]
#                          [--url https://…] [--ttl 600] [--expanded] [--ring] [--priority 70]
#                          [--action Retry --action-url https://ci/retry]
#                          [--action2 Deploy --action2-shortcut "Ship it" --action2-symbol play.fill]
#   notchctl end <id>
#   notchctl alert "Deployed" [--symbol checkmark.circle.fill] [--tint green] [--duration 3] [--expanded]
#   notchctl timer <minutes> [--label Tea]      notchctl timer cancel|pause|resume
#   notchctl timer add [minutes]                (another minute for the running timer)
#   notchctl timer pomodoro [--work 25] [--rest 5] [--cycles 4] [--long 15]
#   notchctl sleep [minutes]                     notchctl sleep cancel
#   notchctl alarm <07:30|19:30|7:30pm> [label]  (the next time the clock reads it)
#   notchctl alarm cancel [07:30]                (that one, or every alarm)
#   notchctl stopwatch [lap|stop|reset]
#   notchctl shelf add <path>                   notchctl shelf clear
#   notchctl home [home|music|today|windows|shelf|clipboard|actions|notes|stats] | collapse
#   notchctl settings [general|island|activities|home|media|actions|privacy|about]
#   notchctl ask "Deploy to production?" [--detail "main at 4f2c1"] [--yes Deploy] [--no Wait] [--timeout 60]
#                                        (answered on the island, or with Control-Y / Control-N;
#                                         prints yes, no or timeout and exits 0, 1 or 2)
#   notchctl --help                             (this, on standard output, exiting 0)
#
# Exit status. Only `ask` has answers, and only a yes is success, so `if notchctl ask …; then`
# means what it says; nothing that goes wrong before a question is asked exits 1 or 2.
#     0    sent; for ask, answered yes
#     1    ask: answered no
#     2    ask: nobody answered in time, or the island never wrote an answer
#    64    bad usage: a missing argument, or an unknown command or flag; nothing was sent
#    66    shelf add: no such file
#    69    Notch Island could not be reached: `open` refused the notchisland:// URL
#   130    ask: interrupted with Control-C while waiting for the answer
#   143    ask: terminated (SIGTERM) while waiting for the answer
set -euo pipefail

# Bad usage, said the one way everywhere: what was wrong, then the command's own usage line
# when it has one, and 64 — never 1 or 2, which `ask` uses for its answers.
usage() {
  local line
  for line in "$@"; do echo "$line" >&2; done
  exit 64
}

# Percent-encodes a query value one byte at a time. In a UTF-8 locale bash counts and slices
# characters, and printf "'c" gives a character's code point rather than its bytes, so "é"
# came out as %E9 and an emoji as %1F600, neither of which decodes. Under LC_ALL=C every
# byte is a character of its own, and each is written as its own %XX. The & 0xFF keeps a byte
# over 0x7F positive should a bash read it as a signed char, which printf would print as
# sixteen hex digits. LC_ALL is set before anything measures the string, and is local, so the
# rest of the script keeps the caller's locale.
urlencode() {
  local LC_ALL=C
  local s="$1" out="" c i
  for (( i = 0; i < ${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+=$(printf '%%%02X' $(( $(printf '%d' "'$c") & 0xFF ))) ;;
    esac
  done
  printf '%s' "$out"
}

query=()
add() { query+=("$1=$(urlencode "$2")"); }

open_url() {
  local base="$1" q=""
  if (( ${#query[@]} )); then q="?$(IFS='&'; echo "${query[*]}")"; fi
  if ! open -g "notchisland://${base}${q}"; then
    echo "notchctl: could not reach Notch Island (is it installed?)" >&2
    exit 69
  fi
}

parse_flags() {
  local flag value have key
  while (( $# )); do
    flag="$1"; value="${2-}"; have=$(( $# >= 2 )); shift
    case "$flag" in
      --expanded) add expanded 1; continue ;;
      --ring) add ring 1; continue ;;
    esac
    # Every other flag takes a value. Which flag is checked first and the value second, so a
    # flag left as the last word on the line — which used to die on bash's "unbound
    # variable" — is told it needs one, and one that is not a flag at all is told that.
    case "$flag" in
      --title) key=title ;;
      --subtitle) key=subtitle ;;
      --symbol|--icon) key=symbol ;;
      --tint|--color) key=tint ;;
      --progress) key=progress ;;
      --trailing) key=trailing ;;
      --body) key=body ;;
      --url) key=url ;;
      --ttl) key=ttl ;;
      --duration) key=duration ;;
      --priority) key=priority ;;
      --label) key=label ;;
      --work) key=work ;;
      --rest) key=rest ;;
      --cycles) key=cycles ;;
      --long) key=long ;;
      # Buttons. Each takes a name and one of a link or a Shortcut, and there are two slots.
      --action) key=action ;;
      --action-url) key=action_url ;;
      --action-shortcut) key=action_shortcut ;;
      --action-symbol) key=action_symbol ;;
      --action2) key=action2 ;;
      --action2-url) key=action2_url ;;
      --action2-shortcut) key=action2_shortcut ;;
      --action2-symbol) key=action2_symbol ;;
      *) usage "notchctl: unknown flag: $flag" ;;
    esac
    if (( ! have )); then usage "notchctl: $flag needs a value"; fi
    add "$key" "$value"; shift
  done
}

# The comment block at the top, however long it grows: a fixed line range is a usage message
# that goes quietly out of date the first time a command is added.
help_text() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  activity)
    if [ -z "${1:-}" ]; then usage "notchctl activity: an id is required" "usage: notchctl activity <id> --title TEXT [flags]"; fi
    add id "$1"; shift; parse_flags "$@"; open_url "activity" ;;
  end)
    if [ -z "${1:-}" ]; then usage "usage: notchctl end <id>"; fi
    add id "$1"; open_url "activity/end" ;;
  alert)
    if [ -z "${1:-}" ]; then usage "usage: notchctl alert TITLE [flags]"; fi
    add title "$1"; shift; parse_flags "$@"; open_url "alert" ;;
  timer)
    case "${1:-}" in
      cancel|stop|pause|resume) open_url "timer/$1" ;;
      add) shift; add minutes "${1:-1}"; open_url "timer/add" ;;
      pomodoro) shift; parse_flags "$@"; open_url "timer/pomodoro" ;;
      "") usage "usage: notchctl timer <minutes> [--label TEXT] | add [minutes] | cancel | pause | resume | pomodoro" ;;
      *) add minutes "$1"; shift; parse_flags "$@"; open_url "timer" ;;
    esac ;;
  # The URL scheme has had these since the stopwatch did; this wrapper had not.
  sleep)
    case "${1:-}" in
      cancel|stop) open_url "sleep/cancel" ;;
      "") open_url "sleep" ;;
      *) add minutes "$1"; open_url "sleep" ;;
    esac ;;
  # The time is read by the app with the same rule as a time typed on Actions, so anything
  # the island would take there it takes here; the label is the rest of the line.
  alarm)
    case "${1:-}" in
      cancel|stop) shift; if [ -n "${1:-}" ]; then add at "$1"; fi; open_url "alarm/cancel" ;;
      "") usage "usage: notchctl alarm <time> [label] | cancel [time]" ;;
      *)
        add at "$1"; shift
        if [[ "${1:-}" == --* ]]; then parse_flags "$@"; elif (( $# )); then add label "$*"; fi
        open_url "alarm" ;;
    esac ;;
  stopwatch)
    case "${1:-}" in
      ""|start) open_url "stopwatch" ;;
      lap|stop|pause|reset|cancel) open_url "stopwatch/$1" ;;
      *) usage "usage: notchctl stopwatch [lap|stop|reset]" ;;
    esac ;;
  shelf)
    case "${1:-}" in
      add)
        # With no path this died on bash's "unbound variable"; with one that is not there, `cd`
        # failed quietly inside the substitution and "/name" went to the island instead.
        if [ -z "${2:-}" ]; then usage "usage: notchctl shelf add <path>"; fi
        if [ ! -e "$2" ]; then echo "notchctl shelf add: no such file: $2" >&2; exit 66; fi
        add path "$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"; open_url "shelf/add" ;;
      clear) open_url "shelf/clear" ;;
      *) usage "usage: notchctl shelf add <path> | clear" ;;
    esac ;;
  home)
    if [ -n "${1:-}" ]; then open_url "home/$1"; else open_url "home"; fi ;;
  collapse)
    open_url "$cmd" ;;
  settings)
    if [ -n "${1:-}" ]; then open_url "settings/$1"; else open_url "settings"; fi ;;
  # A question on the island, held there until it is answered with a click or Control-Y /
  # Control-N, or until its time is up. The island writes the answer to a file in a folder of
  # our own, and we wait for the file. What it exits with is the table at the top.
  ask)
    ask_usage='usage: notchctl ask "Question" [--detail TEXT] [--yes LABEL] [--no LABEL] [--timeout SECONDS]'
    if [ -z "${1:-}" ] || [[ "$1" == --* ]]; then usage "$ask_usage"; fi
    add title "$1"; shift
    wait_for=60
    while (( $# )); do
      case "$1" in
        --detail|--yes|--no|--timeout)
          if (( $# < 2 )); then usage "notchctl ask: $1 needs a value"; fi
          case "$1" in
            --detail) add detail "$2" ;;
            --yes) add yes "$2" ;;
            --no) add no "$2" ;;
            --timeout)
              if ! [[ "$2" =~ ^[0-9]{1,6}$ ]]; then usage "notchctl ask: --timeout takes whole seconds"; fi
              wait_for=$(( 10#$2 )) ;;
          esac
          shift 2 ;;
        *) usage "notchctl ask: unknown flag: $1" "$ask_usage" ;;
      esac
    done
    # The island's own limits, so the two ends count to the same second.
    if (( wait_for < 5 )); then wait_for=5; fi
    if (( wait_for > 600 )); then wait_for=600; fi
    add timeout "$wait_for"
    # In /tmp, not $TMPDIR: the island writes only inside the home folder or /tmp, and macOS's
    # $TMPDIR is neither. The folder is ours alone (mktemp makes it 0700); the island creates
    # the file in it, and never replaces one that is already there.
    ask_dir=$(mktemp -d /tmp/notchctl-ask.XXXXXX)
    trap 'rm -rf "$ask_dir"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    reply="$ask_dir/answer"
    add reply "$reply"
    open_url "ask"
    # Every fifth of a second until the answer is there, or until a few seconds past the
    # island's own timeout — an island that was quit, or never got the question, never writes.
    answer=timeout
    for (( i = 0; i < (wait_for + 3) * 5; i++ )); do
      if [ -f "$reply" ]; then answer=$(tr -d '[:space:]' < "$reply"); break; fi
      sleep 0.2
    done
    # The same table as `AskAnswer.exitStatus`; AskTests reads these three lines.
    case "$answer" in
      yes) echo yes; exit 0 ;;
      no) echo no; exit 1 ;;
      *) echo timeout; exit 2 ;;
    esac ;;
  # Asked for, it is the answer, on standard output, and success. Not asked for — no command,
  # or one this does not know — it is the reason nothing happened, and bad usage.
  -h|--help|help)
    help_text; exit 0 ;;
  "")
    help_text >&2; exit 64 ;;
  *)
    echo "notchctl: unknown command: $cmd" >&2; help_text >&2; exit 64 ;;
esac
