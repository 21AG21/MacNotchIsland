#!/usr/bin/env bash
# notchctl — drive Notch Island from the command line (wraps the notchisland:// URL scheme).
#
#   notchctl activity <id> --title "Building" [--subtitle "xcodebuild"] [--symbol hammer.fill]
#                          [--tint blue] [--progress 0.4] [--trailing "40%"] [--body "…"]
#                          [--url https://…] [--ttl 600] [--expanded] [--ring] [--priority 70]
#                          [--action Retry --action-url https://ci/retry]
#                          [--action2 Deploy --action2-shortcut "Ship it" --action2-symbol play.fill]
#                          (--action-shortcut and --action2-shortcut run only while "Let pushed
#                           cards run Shortcuts" is on under Settings > Media, off out of the box)
#   notchctl end <id>
#   notchctl alert "Deployed" [--symbol checkmark.circle.fill] [--tint green] [--duration 3] [--expanded]
#                          (--duration is up to 60 s; longer is cut to 60)
#   notchctl timer <minutes> [--label Tea]      notchctl timer cancel|pause|resume
#   notchctl timer add [minutes]                (another minute for the running timer)
#   notchctl timer pomodoro [--work 25] [--rest 5] [--cycles 4] [--long 15]
#   notchctl sleep [minutes]                     notchctl sleep cancel
#   notchctl alarm <07:30|19:30|7:30 pm|7pm> [label]  (the next time the clock reads it)
#   notchctl alarm cancel [07:30]                (that one, or every alarm)
#   notchctl stopwatch [lap|stop|reset]
#   notchctl shelf add <path>                   notchctl shelf clear
#   notchctl home [home|music|today|windows|shelf|controls|clipboard|actions|notes|stats|notifications]
#   notchctl collapse
#   notchctl settings [general|island|motion|activities|home|media|actions|shortcuts|privacy|about]
#   notchctl ask "Deploy to production?" [--detail "main at 4f2c1"] [--yes Deploy] [--no Wait] [--timeout 60]
#                                        (answered on the island, or with Control-Y / Control-N;
#                                         prints yes, no or timeout and exits 0, 1 or 2;
#                                         --timeout is 5 to 600 s: less is 5, more is 600)
#   notchctl --help                             (this, on standard output, exiting 0)
#
# Lengths are numbers, in the unit the flag names (minutes for timers, seconds for --ttl,
# --duration and ask's --timeout), or numbers with a unit of their own: 45, 45m, 90s, 1.5h. A
# timer is at most a day. --progress is a share from 0 to 1, 0.4 for 40%. An alarm's time is
# H:MM or HH:MM (or 19.30, 19h30, 7h), 24-hour unless am or pm follows, with or without a space:
# 7pm, 7:30 pm. Anything else is bad usage, and nothing is sent.
#
# Exit status. Only `ask` has answers, and only a yes is success, so `if notchctl ask …; then`
# means what it says; nothing that goes wrong before a question is asked exits 1 or 2.
#     0    sent; for ask, answered yes
#     1    ask: answered no
#     2    ask: nobody answered in time, or the island never wrote an answer
#    64    bad usage: a missing argument, an unknown command or flag, or a length, a share or a
#          time that is not one; nothing was sent
#    66    shelf add: no such file
#    69    Notch Island could not be reached: `open` refused the notchisland:// URL
#    73    ask: no folder could be made in /tmp for the answer; nothing was sent
#   130    ask: interrupted with Control-C while waiting for the answer (the question is taken down)
#   143    ask: terminated (SIGTERM) while waiting for the answer (the question is taken down)
set -euo pipefail

# Bad usage, said the one way everywhere: what was wrong, then the command's own usage line
# when it has one, and 64 — never 1 or 2, which `ask` uses for its answers.
usage() {
  local line
  for line in "$@"; do echo "$line" >&2; done
  exit 64
}

# Percent-encodes a query value one byte at a time. In a UTF-8 locale bash counts and slices
# characters, and printf "'c" gives a character's code point rather than its bytes, so "é"
# came out as %E9 and an emoji as %1F600, neither of which decodes. Under LC_ALL=C every
# byte is a character of its own, and each is written as its own %XX. The & 0xFF keeps a byte
# over 0x7F positive should a bash read it as a signed char, which printf would print as
# sixteen hex digits. LC_ALL is set before anything measures the string, and is local, so the
# rest of the script keeps the caller's locale.
urlencode() {
  local LC_ALL=C
  local s="$1" out="" c i
  for (( i = 0; i < ${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+=$(printf '%%%02X' $(( $(printf '%d' "'$c") & 0xFF ))) ;;
    esac
  done
  printf '%s' "$out"
}

query=()
add() { query+=("$1=$(urlencode "$2")"); }

# A length as the island reads one (`LiveActivityAPI.length`): a plain number, then optionally a
# unit. `seconds_of VALUE BARE` prints it in seconds, a bare number counting BARE seconds each,
# and fails for anything else. The island used to read "45m" as no number at all and run its
# default instead — thirty minutes for `sleep 45m` — while this said nothing and exited 0.
length_re='^(-?[0-9]+([.][0-9]+)?)[[:space:]]*([a-z]*)$'
seconds_of() {
  local v scale
  v=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  [[ "$v" =~ $length_re ]] || return 1
  case "${BASH_REMATCH[3]}" in
    "") scale=$2 ;;
    s|sec|secs|second|seconds) scale=1 ;;
    m|min|mins|minute|minutes) scale=60 ;;
    h|hr|hrs|hour|hours) scale=3600 ;;
    *) return 1 ;;
  esac
  # In the C locale, so the point is a point wherever the caller is.
  LC_ALL=C awk -v n="${BASH_REMATCH[1]}" -v u="$scale" 'BEGIN { printf "%.3f\n", n * u }'
}

# Whether a length in seconds is inside a range, given as an awk condition on s.
length_in() { LC_ALL=C awk -v s="$1" "BEGIN { exit !($2) }"; }

# Checks a length for a command, as bad usage when it is not one: WHAT VALUE BARE CONDITION HINT.
need_length() {
  local secs
  if ! secs=$(seconds_of "$2" "$3") || ! length_in "$secs" "$4"; then
    usage "notchctl: $1 takes $5, not \"$2\""
  fi
}
timer_range='s > 0 && s <= 86400'
timer_hint='a length of up to a day (25, 25m, 90s, 1.5h)'

# A whole number above nought, for a count.
need_count() {
  if ! [[ "$2" =~ ^[0-9]{1,4}$ ]] || (( 10#$2 == 0 )); then usage "notchctl: $1 takes a whole number above nought, not \"$2\""; fi
}

# A share of the way, as the island reads `progress=` (`LiveActivityAPI`): a plain decimal from
# 0 to 1, with a point. The island read anything else as no bar at all or as a full one — "0,4"
# was no bar and "40" a bar at 100% — while this said nothing and exited 0.
need_fraction() {
  if ! [[ "$2" =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)$ ]] || ! length_in "$2" 's <= 1'; then
    usage "notchctl: $1 takes a share from 0 to 1 (0.4 for 40%), not \"$2\""
  fi
}

# Whether a time is one the island reads as a time on the clock (`TimerEntry.clockTime`): H or
# HH, then a colon, a point or an h and two figures of minutes ("7:30", "07.30", "19h30"), or an
# h alone for the hour ("7h"); 24-hour, unless am or pm follows ("7pm", "7:30 p.m.", "7 a"), and
# then the hour is 1 to 12. A bare number is not a time — the island reads it as minutes, and
# refused `alarm 7` while this exited 0 — unless am or pm says it is. In the C locale, so a
# figure is 0 to 9 whatever the caller's language.
is_clock_time() {
  local LC_ALL=C
  local t mark="" m hour minute sep
  t=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  t="${t#"${t%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
  # The same marks in the same order as the island, so "7:30 a.m." loses "a.m." and not "."
  for m in a.m. p.m. am pm a p; do
    if [[ "$t" == *"$m" ]]; then
      mark="${m:0:1}"; t="${t%"$m"}"; t="${t%"${t##*[![:space:]]}"}"
      break
    fi
  done
  if [[ "$t" =~ ^([0-9]{1,2})([:.h])([0-9]*)$ ]]; then
    hour="${BASH_REMATCH[1]}"; sep="${BASH_REMATCH[2]}"; minute="${BASH_REMATCH[3]}"
    # An h ends a time, as a colon does not: "7h" is on the hour, "7:" is nothing.
    if [ -z "$minute" ] && [ "$sep" = h ]; then minute=00; fi
    [[ "$minute" =~ ^[0-9]{2}$ ]] || return 1
    (( 10#$minute < 60 )) || return 1
  elif [[ "$t" =~ ^[0-9]{1,2}$ ]] && [ -n "$mark" ]; then
    hour="$t"
  else
    return 1
  fi
  if [ -n "$mark" ]; then (( 10#$hour >= 1 && 10#$hour <= 12 )); else (( 10#$hour < 24 )); fi
}

alarm_usage='usage: notchctl alarm <time> [label] | cancel [time]   (a time is 7:30, 19:30, 19h30, 7pm or 7:30 pm)'

# The time at the front of an alarm command's words, into `alarm_at`, and how many words it took,
# into `alarm_words`. "7:30 pm" typed as two words is one time: the pm was read as the alarm's
# name, and `alarm 7:30 pm` set half past seven in the morning, called "pm"; `alarm cancel 7:30
# pm` took the morning one away. Bad usage when it is not a time the island reads.
alarm_time() {
  alarm_at="$1"; alarm_words=1
  case "$(printf '%s' "${2-}" | tr '[:upper:]' '[:lower:]')" in
    am|pm|a.m.|p.m.) alarm_at="$1 $2"; alarm_words=2 ;;
  esac
  if ! is_clock_time "$alarm_at"; then usage "notchctl alarm: \"$alarm_at\" is not a time" "$alarm_usage"; fi
}

open_url() {
  local base="$1" q=""
  if (( ${#query[@]} )); then q="?$(IFS='&'; echo "${query[*]}")"; fi
  if ! open -g "notchisland://${base}${q}"; then
    echo "notchctl: could not reach Notch Island (is it installed?)" >&2
    exit 69
  fi
}

parse_flags() {
  local flag value have key
  while (( $# )); do
    flag="$1"; value="${2-}"; have=$(( $# >= 2 )); shift
    case "$flag" in
      --expanded) add expanded 1; continue ;;
      --ring) add ring 1; continue ;;
    esac
    # Every other flag takes a value. Which flag is checked first and the value second, so a
    # flag left as the last word on the line — which used to die on bash's "unbound
    # variable" — is told it needs one, and one that is not a flag at all is told that.
    case "$flag" in
      --title) key=title ;;
      --subtitle) key=subtitle ;;
      --symbol|--icon) key=symbol ;;
      --tint|--color) key=tint ;;
      --progress) key=progress ;;
      --trailing) key=trailing ;;
      --body) key=body ;;
      --url) key=url ;;
      --ttl) key=ttl ;;
      --duration) key=duration ;;
      --priority) key=priority ;;
      --label) key=label ;;
      --work) key=work ;;
      --rest) key=rest ;;
      --cycles) key=cycles ;;
      --long) key=long ;;
      # Buttons. Each takes a name and one of a link or a Shortcut, and there are two slots.
      --action) key=action ;;
      --action-url) key=action_url ;;
      --action-shortcut) key=action_shortcut ;;
      --action-symbol) key=action_symbol ;;
      --action2) key=action2 ;;
      --action2-url) key=action2_url ;;
      --action2-shortcut) key=action2_shortcut ;;
      --action2-symbol) key=action2_symbol ;;
      *) usage "notchctl: unknown flag: $flag" ;;
    esac
    if (( ! have )); then usage "notchctl: $flag needs a value"; fi
    case "$key" in
      progress) need_fraction "$flag" "$value" ;;
      work|rest|long) need_length "$flag" "$value" 60 "$timer_range" "$timer_hint" ;;
      cycles) need_count "$flag" "$value" ;;
      ttl|duration) need_length "$flag" "$value" 1 's > 0' 'a length above nought (600, 10m)' ;;
    esac
    add "$key" "$value"; shift
  done
}

# The comment block at the top, however long it grows: a fixed line range is a usage message
# that goes quietly out of date the first time a command is added.
help_text() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  activity)
    if [ -z "${1:-}" ]; then usage "notchctl activity: an id is required" "usage: notchctl activity <id> --title TEXT [flags]"; fi
    add id "$1"; shift; parse_flags "$@"; open_url "activity" ;;
  end)
    if [ -z "${1:-}" ]; then usage "usage: notchctl end <id>"; fi
    add id "$1"; open_url "activity/end" ;;
  alert)
    if [ -z "${1:-}" ]; then usage "usage: notchctl alert TITLE [flags]"; fi
    add title "$1"; shift; parse_flags "$@"; open_url "alert" ;;
  timer)
    case "${1:-}" in
      cancel|stop|pause|resume) open_url "timer/$1" ;;
      add)
        # A minute less is a minute of its own: `timer add -1`.
        shift
        need_length "timer add" "${1:-1}" 60 's != 0 && s >= -86400 && s <= 86400' 'a length of up to a day either way (1, 5m, -1)'
        add minutes "${1:-1}"; open_url "timer/add" ;;
      pomodoro) shift; parse_flags "$@"; open_url "timer/pomodoro" ;;
      "") usage "usage: notchctl timer <minutes> [--label TEXT] | add [minutes] | cancel | pause | resume | pomodoro" ;;
      *) need_length "timer" "$1" 60 "$timer_range" "$timer_hint"; add minutes "$1"; shift; parse_flags "$@"; open_url "timer" ;;
    esac ;;
  # The URL scheme has had these since the stopwatch did; this wrapper had not.
  sleep)
    case "${1:-}" in
      cancel|stop) open_url "sleep/cancel" ;;
      "") open_url "sleep" ;;
      *) need_length "sleep" "$1" 60 "$timer_range" "$timer_hint"; add minutes "$1"; open_url "sleep" ;;
    esac ;;
  # The time is read by the app with the same rule as a time typed on Actions, and checked
  # here against that rule first (`is_clock_time`), so what the island would refuse is bad usage
  # rather than a 0 for nothing done. The label is the rest of the line.
  alarm)
    case "${1:-}" in
      cancel|stop)
        shift
        if (( $# )); then
          alarm_time "$@"; shift "$alarm_words"
          if (( $# )); then usage "notchctl alarm cancel: one time, and nothing after it: \"$*\"" "$alarm_usage"; fi
          add at "$alarm_at"
        fi
        open_url "alarm/cancel" ;;
      "") usage "$alarm_usage" ;;
      *)
        alarm_time "$@"; shift "$alarm_words"
        add at "$alarm_at"
        if [[ "${1:-}" == --* ]]; then parse_flags "$@"; elif (( $# )); then add label "$*"; fi
        open_url "alarm" ;;
    esac ;;
  stopwatch)
    case "${1:-}" in
      ""|start) open_url "stopwatch" ;;
      lap|stop|pause|reset|cancel) open_url "stopwatch/$1" ;;
      *) usage "usage: notchctl stopwatch [lap|stop|reset]" ;;
    esac ;;
  shelf)
    case "${1:-}" in
      add)
        # With no path this died on bash's "unbound variable"; with one that is not there, `cd`
        # failed quietly inside the substitution and "/name" went to the island instead. With
        # CDPATH exported, `cd` printed the folder it found — a second line in the path — or
        # found a folder of the same name somewhere else; and a name starting with "-" was an
        # option to dirname and basename.
        if [ -z "${2:-}" ]; then usage "usage: notchctl shelf add <path>"; fi
        if [ ! -e "$2" ]; then echo "notchctl shelf add: no such file: $2" >&2; exit 66; fi
        if ! shelf_dir=$(CDPATH='' cd -- "$(dirname -- "$2")" && pwd); then
          echo "notchctl shelf add: no such file: $2" >&2; exit 66
        fi
        add path "$shelf_dir/$(basename -- "$2")"; open_url "shelf/add" ;;
      clear) open_url "shelf/clear" ;;
      *) usage "usage: notchctl shelf add <path> | clear" ;;
    esac ;;
  home)
    if [ -n "${1:-}" ]; then open_url "home/$1"; else open_url "home"; fi ;;
  collapse)
    open_url "$cmd" ;;
  settings)
    if [ -n "${1:-}" ]; then open_url "settings/$1"; else open_url "settings"; fi ;;
  # A question on the island, held there until it is answered with a click or Control-Y /
  # Control-N, or until its time is up. The island writes the answer to a file in a folder of
  # our own, and we wait for the file. What it exits with is the table at the top.
  ask)
    ask_usage='usage: notchctl ask "Question" [--detail TEXT] [--yes LABEL] [--no LABEL] [--timeout 5-600 SECONDS]'
    if [ -z "${1:-}" ] || [[ "$1" == --* ]]; then usage "$ask_usage"; fi
    add title "$1"; shift
    wait_for=60
    while (( $# )); do
      case "$1" in
        --detail|--yes|--no|--timeout)
          if (( $# < 2 )); then usage "notchctl ask: $1 needs a value"; fi
          case "$1" in
            --detail) add detail "$2" ;;
            --yes) add yes "$2" ;;
            --no) add no "$2" ;;
            --timeout)
              # A length as every other flag reads one (60, 90s, 2m), as the island reads
              # `timeout=`; sent as whole seconds, held to the island's own 5 to 600 so the two
              # ends count to the same second. Held in awk, where a length of a hundred digits
              # is still a number, rather than in bash, where it would wrap round.
              need_length "ask --timeout" "$2" 1 's >= 0' 'a length in seconds (60, 90s, 2m)'
              wait_for=$(LC_ALL=C awk -v s="$(seconds_of "$2" 1)" \
                'BEGIN { s += 0; if (s < 5) s = 5; if (s > 600) s = 600; printf "%d\n", s + 0.5 }') ;;
          esac
          shift 2 ;;
        *) usage "notchctl ask: unknown flag: $1" "$ask_usage" ;;
      esac
    done
    add timeout "$wait_for"
    # The island writes only into a folder of the user's own, open to nobody else, inside /tmp
    # or $TMPDIR — never the home folder — which is what mktemp -d makes. The island creates the
    # file in it, and never replaces one that is already there.
    # A folder that cannot be made is not a no: under `set -e` the failed assignment exited
    # 1, which is the answer no, for a question that was never asked.
    if ! ask_dir=$(mktemp -d /tmp/notchctl-ask.XXXXXX); then
      echo "notchctl ask: could not make a folder in /tmp for the answer" >&2
      exit 73
    fi
    # A secret of this question's own, which the island asks for before it takes the question
    # down unanswered (`notchisland://ask/cancel`). Without one the question is not cancelled
    # by URL, and still comes down when the folder goes.
    ask_token=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n') || ask_token=""
    # Interrupted, the question is taken down rather than left holding the island, and
    # Control-Y and Control-N, for the rest of its time with nobody waiting for the answer.
    cancel_ask() {
      if [ -n "$ask_token" ]; then open -g "notchisland://ask/cancel?token=$ask_token" >/dev/null 2>&1 || true; fi
    }
    trap 'rm -rf "$ask_dir"' EXIT
    trap 'cancel_ask; exit 130' INT
    trap 'cancel_ask; exit 143' TERM
    reply="$ask_dir/answer"
    add reply "$reply"
    if [ -n "$ask_token" ]; then add token "$ask_token"; fi
    open_url "ask"
    # Every fifth of a second until the answer is there, or until a few seconds past the
    # island's own timeout — an island that was quit, or never got the question, never writes.
    answer=timeout
    for (( i = 0; i < (wait_for + 3) * 5; i++ )); do
      if [ -f "$reply" ]; then answer=$(tr -d '[:space:]' < "$reply"); break; fi
      sleep 0.2
    done
    # The same table as `AskAnswer.exitStatus`; AskTests reads these three lines.
    case "$answer" in
      yes) echo yes; exit 0 ;;
      no) echo no; exit 1 ;;
      *) echo timeout; exit 2 ;;
    esac ;;
  # Asked for, it is the answer, on standard output, and success. Not asked for — no command,
  # or one this does not know — it is the reason nothing happened, and bad usage.
  -h|--help|help)
    help_text; exit 0 ;;
  "")
    help_text >&2; exit 64 ;;
  *)
    echo "notchctl: unknown command: $cmd" >&2; help_text >&2; exit 64 ;;
esac
