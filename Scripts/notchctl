#!/usr/bin/env bash
# notchctl — drive Notch Island from the command line (wraps the notchisland:// URL scheme).
#
#   notchctl activity <id> --title "Building" [--subtitle "xcodebuild"] [--symbol hammer.fill]
#                          [--tint blue] [--progress 0.4] [--trailing "40%"] [--body "…"]
#                          [--url https://…] [--ttl 600] [--expanded] [--ring] [--priority 70]
#                          [--action Retry --action-url https://ci/retry]
#                          [--action2 Deploy --action2-shortcut "Ship it" --action2-symbol play.fill]
#   notchctl end <id>
#   notchctl alert "Deployed" [--symbol checkmark.circle.fill] [--tint green] [--duration 3] [--expanded]
#   notchctl timer <minutes> [--label Tea]      notchctl timer cancel|pause|resume
#   notchctl timer add [minutes]                (another minute for the running timer)
#   notchctl timer pomodoro [--work 25] [--rest 5] [--cycles 4] [--long 15]
#   notchctl sleep [minutes]                     notchctl sleep cancel
#   notchctl alarm <07:30|19:30|7:30pm> [label]  (the next time the clock reads it)
#   notchctl alarm cancel [07:30]                (that one, or every alarm)
#   notchctl stopwatch [lap|stop|reset]
#   notchctl shelf add <path>                   notchctl shelf clear
#   notchctl home [home|music|today|windows|shelf|clipboard|actions|notes|stats] | collapse
#   notchctl settings [general|island|activities|home|media|actions|privacy|about]
#   notchctl ask "Deploy to production?" [--detail "main at 4f2c1"] [--yes Deploy] [--no Wait] [--timeout 60]
#                                        (answered on the island, or with Control-Y / Control-N;
#                                         prints yes, no or timeout and exits 0, 1 or 2)
set -euo pipefail

# Percent-encodes a query value one byte at a time. In a UTF-8 locale bash counts and slices
# characters, and printf "'c" gives a character's code point rather than its bytes, so "é"
# came out as %E9 and an emoji as %1F600, neither of which decodes. Under LC_ALL=C every
# byte is a character of its own, and each is written as its own %XX. The & 0xFF keeps a byte
# over 0x7F positive should a bash read it as a signed char, which printf would print as
# sixteen hex digits. LC_ALL is set before anything measures the string, and is local, so the
# rest of the script keeps the caller's locale.
urlencode() {
  local LC_ALL=C
  local s="$1" out="" c i
  for (( i = 0; i < ${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+=$(printf '%%%02X' $(( $(printf '%d' "'$c") & 0xFF ))) ;;
    esac
  done
  printf '%s' "$out"
}

query=()
add() { query+=("$1=$(urlencode "$2")"); }

open_url() {
  local base="$1" q=""
  if (( ${#query[@]} )); then q="?$(IFS='&'; echo "${query[*]}")"; fi
  open -g "notchisland://${base}${q}"
}

parse_flags() {
  while (( $# )); do
    case "$1" in
      --title) add title "$2"; shift 2 ;;
      --subtitle) add subtitle "$2"; shift 2 ;;
      --symbol|--icon) add symbol "$2"; shift 2 ;;
      --tint|--color) add tint "$2"; shift 2 ;;
      --progress) add progress "$2"; shift 2 ;;
      --trailing) add trailing "$2"; shift 2 ;;
      --body) add body "$2"; shift 2 ;;
      --url) add url "$2"; shift 2 ;;
      --ttl) add ttl "$2"; shift 2 ;;
      --duration) add duration "$2"; shift 2 ;;
      --priority) add priority "$2"; shift 2 ;;
      --label) add label "$2"; shift 2 ;;
      --work) add work "$2"; shift 2 ;;
      --rest) add rest "$2"; shift 2 ;;
      --cycles) add cycles "$2"; shift 2 ;;
      --long) add long "$2"; shift 2 ;;
      --expanded) add expanded 1; shift ;;
      --ring) add ring 1; shift ;;
      # Buttons. Each takes a name and one of a link or a Shortcut, and there are two slots.
      --action) add action "$2"; shift 2 ;;
      --action-url) add action_url "$2"; shift 2 ;;
      --action-shortcut) add action_shortcut "$2"; shift 2 ;;
      --action-symbol) add action_symbol "$2"; shift 2 ;;
      --action2) add action2 "$2"; shift 2 ;;
      --action2-url) add action2_url "$2"; shift 2 ;;
      --action2-shortcut) add action2_shortcut "$2"; shift 2 ;;
      --action2-symbol) add action2_symbol "$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 2 ;;
    esac
  done
}

cmd="${1:-}"; shift || true
case "$cmd" in
  activity)
    id="${1:?activity id required}"; shift
    add id "$id"; parse_flags "$@"; open_url "activity" ;;
  end)
    add id "${1:?activity id required}"; open_url "activity/end" ;;
  alert)
    add title "${1:?alert title required}"; shift; parse_flags "$@"; open_url "alert" ;;
  timer)
    case "${1:-}" in
      cancel|stop|pause|resume) open_url "timer/$1" ;;
      add) shift; add minutes "${1:-1}"; open_url "timer/add" ;;
      pomodoro) shift; parse_flags "$@"; open_url "timer/pomodoro" ;;
      *) add minutes "${1:?minutes required}"; shift; parse_flags "$@"; open_url "timer" ;;
    esac ;;
  # The URL scheme has had these since the stopwatch did; this wrapper had not.
  sleep)
    case "${1:-}" in
      cancel|stop) open_url "sleep/cancel" ;;
      "") open_url "sleep" ;;
      *) add minutes "$1"; open_url "sleep" ;;
    esac ;;
  # The time is read by the app with the same rule as a time typed on Actions, so anything
  # the island would take there it takes here; the label is the rest of the line.
  alarm)
    case "${1:-}" in
      cancel|stop) shift; if [ -n "${1:-}" ]; then add at "$1"; fi; open_url "alarm/cancel" ;;
      "") echo "usage: notchctl alarm <time> [label] | cancel [time]" >&2; exit 2 ;;
      *)
        add at "$1"; shift
        if [[ "${1:-}" == --* ]]; then parse_flags "$@"; elif (( $# )); then add label "$*"; fi
        open_url "alarm" ;;
    esac ;;
  stopwatch)
    case "${1:-}" in
      ""|start) open_url "stopwatch" ;;
      lap|stop|pause|reset|cancel) open_url "stopwatch/$1" ;;
      *) echo "usage: notchctl stopwatch [lap|stop|reset]" >&2; exit 2 ;;
    esac ;;
  shelf)
    case "${1:-}" in
      add) add path "$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"; open_url "shelf/add" ;;
      clear) open_url "shelf/clear" ;;
      *) echo "usage: notchctl shelf add <path> | clear" >&2; exit 2 ;;
    esac ;;
  home)
    if [ -n "${1:-}" ]; then open_url "home/$1"; else open_url "home"; fi ;;
  collapse)
    open_url "$cmd" ;;
  settings)
    if [ -n "${1:-}" ]; then open_url "settings/$1"; else open_url "settings"; fi ;;
  # A question on the island, held there until it is answered with a click or Control-Y /
  # Control-N, or until its time is up. The island writes the answer to a file in a folder of
  # our own, and we wait for the file. Only a yes exits 0, so `if notchctl ask "Deploy?"; then`
  # means what it says, and a question nobody answered is never taken for one. Anything that
  # goes wrong before the question is asked exits 64 or 69, never 1 or 2, which are answers.
  ask)
    ask_usage='usage: notchctl ask "Question" [--detail TEXT] [--yes LABEL] [--no LABEL] [--timeout SECONDS]'
    if [ -z "${1:-}" ] || [[ "$1" == --* ]]; then echo "$ask_usage" >&2; exit 64; fi
    add title "$1"; shift
    wait_for=60
    while (( $# )); do
      case "$1" in
        --detail|--yes|--no|--timeout)
          if (( $# < 2 )); then echo "notchctl ask: $1 needs a value" >&2; exit 64; fi
          case "$1" in
            --detail) add detail "$2" ;;
            --yes) add yes "$2" ;;
            --no) add no "$2" ;;
            --timeout)
              if ! [[ "$2" =~ ^[0-9]{1,6}$ ]]; then echo "notchctl ask: --timeout takes whole seconds" >&2; exit 64; fi
              wait_for=$(( 10#$2 )) ;;
          esac
          shift 2 ;;
        *) echo "notchctl ask: unknown flag: $1" >&2; echo "$ask_usage" >&2; exit 64 ;;
      esac
    done
    # The island's own limits, so the two ends count to the same second.
    if (( wait_for < 5 )); then wait_for=5; fi
    if (( wait_for > 600 )); then wait_for=600; fi
    add timeout "$wait_for"
    # In /tmp, not $TMPDIR: the island writes only inside the home folder or /tmp, and macOS's
    # $TMPDIR is neither. The folder is ours alone (mktemp makes it 0700); the island creates
    # the file in it, and never replaces one that is already there.
    ask_dir=$(mktemp -d /tmp/notchctl-ask.XXXXXX)
    trap 'rm -rf "$ask_dir"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    reply="$ask_dir/answer"
    add reply "$reply"
    if ! open_url "ask"; then echo "notchctl ask: could not reach Notch Island" >&2; exit 69; fi
    # Every fifth of a second until the answer is there, or until a few seconds past the
    # island's own timeout — an island that was quit, or never got the question, never writes.
    answer=timeout
    for (( i = 0; i < (wait_for + 3) * 5; i++ )); do
      if [ -f "$reply" ]; then answer=$(tr -d '[:space:]' < "$reply"); break; fi
      sleep 0.2
    done
    # The same table as `AskAnswer.exitStatus`; AskTests reads these three lines.
    case "$answer" in
      yes) echo yes; exit 0 ;;
      no) echo no; exit 1 ;;
      *) echo timeout; exit 2 ;;
    esac ;;
  *)
    # The comment block at the top, however long it grows: a fixed line range is a usage
    # message that goes quietly out of date the first time a command is added.
    awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 2 ;;
esac
